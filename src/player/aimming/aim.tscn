[gd_scene format=3 uid="uid://coawalah0to4o"]

[sub_resource type="GDScript" id="GDScript_50q83"]
script/source = "extends Node3D
 
@export var max_range: float = 50.0          # How far the laser can reach
 
@onready var ray: RayCast3D = $RayCast3D
@onready var mesh: MeshInstance3D = $MeshInstance3D
 
var player_camera: Camera3D
var aim_target: Vector3 = Vector3.ZERO
var aim_direction: Vector3 = Vector3.FORWARD
var aim_plane: Plane
 
func _ready() -> void:
	ray.enabled = true
	ray.target_position = Vector3(0, 0, -max_range)
	aim_plane = Plane(Vector3.UP, global_position.y)

func _process(_delta: float) -> void:
	player_camera = get_viewport().get_camera_3d()
	if not player_camera:
		return
	var mouse_pos := get_viewport().get_mouse_position()
	var ray_origin := player_camera.project_ray_origin(mouse_pos)
	var ray_dir := player_camera.project_ray_normal(mouse_pos)
	var intersect = aim_plane.intersects_ray(ray_origin, ray_dir)
	if intersect == null:
		return
	var world_target := intersect as Vector3
	var dir_flat := (world_target - global_position)
	dir_flat.y = 0.0
	if dir_flat.length_squared() < 0.001:
		return
	aim_direction = dir_flat.normalized()
	look_at(global_position + aim_direction, Vector3.UP)
	ray.force_raycast_update()
	if ray.is_colliding():
		aim_target = ray.get_collision_point()
	else:
		aim_target = global_position + aim_direction * max_range
	var laser_length := global_position.distance_to(aim_target)
	var mid_point := global_position + aim_direction * (laser_length * 0.5)
	mesh.global_position = mid_point
	mesh.rotation = rotation + Vector3(deg_to_rad(90), 0, 0)
	mesh.scale = Vector3(1.0, laser_length, 1.0)

func get_aim_direction() -> Vector3:
	return aim_direction
 
func get_aim_target() -> Vector3:
	return aim_target
 
func is_hitting() -> bool:
	return ray.is_colliding()

func get_hit_collider() -> Object:
	return ray.get_collider()
"

